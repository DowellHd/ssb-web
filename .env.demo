# Demo environment — runs the full UI locally with no backend and no keys.
#
# Usage:
#   cp .env.demo .env.local && npm install && npm run dev
#
# Demo mode is for `npm run dev` only. next.config.js intentionally refuses to
# build for production with NEXT_PUBLIC_DEMO_MODE=true.
#
# To go back to production, remove .env.local (or set the two flags below to
# their production values: DEMO_MODE=false, BACK_SOON=true).

# ── Demo switches ───────────────────────────────────────────────────────────
# Serve mock data from src/lib/demo-api instead of calling the backend.
NEXT_PUBLIC_DEMO_MODE=true
# Bypass the "Back Soon" page so the real app renders.
NEXT_PUBLIC_BACK_SOON=false

# ── Backend (unused in demo mode; kept so switching back needs no edits) ────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# ── Feature flags ───────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_LIVE_TRADING=false
NEXT_PUBLIC_BETA_MODE=false
# Options chain data: leave unset to use the built-in mock provider.
# NEXT_PUBLIC_OPTIONS_PROVIDER=

# ── External services — intentionally EMPTY so each is disabled ─────────────
# Leave these blank. Do not paste real keys into this file (it is committed).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_CDN_URL=
NEXT_PUBLIC_CDN_HOSTNAME=
# Plaid and Stripe have no client-side keys; both are stubbed in demo mode.
