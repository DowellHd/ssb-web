# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1

# WebSocket URL (for real-time market data)
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Feature Flags
# Demo Mode: Use mock data instead of connecting to backend (perfect for showcasing)
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_ENABLE_LIVE_TRADING=false

# Analytics (optional) — set NEXT_PUBLIC_GA_ID to enable Google Analytics 4
NEXT_PUBLIC_GA_ID=
# PostHog (optional) — set both keys to enable product analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry (optional)
# NEXT_PUBLIC_SENTRY_DSN — public DSN from Sentry project settings (expose to browser)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_AUTH_TOKEN — internal auth token for source map upload at build time (keep secret)
SENTRY_AUTH_TOKEN=
# SENTRY_ORG — your Sentry organisation slug (e.g. "smart-strategies-builder")
SENTRY_ORG=
# SENTRY_PROJECT — your Sentry project slug for this frontend (e.g. "ssb-web")
SENTRY_PROJECT=
